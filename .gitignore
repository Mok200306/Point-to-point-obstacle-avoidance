# ROS 2 and colcon outputs
build/
install/
log/
.ros/

# Gazebo, RViz and local desktop state
.gazebo/
.config/
.rviz2/

# Python caches
__pycache__/
*.py[cod]

# Generated navigation trials
results/*
!results/.gitkeep
# Keep the two documented baseline runs as reviewable evidence.
!results/A_to_B_clearance/
!results/A_to_B_clearance/metrics.yaml
!results/A_to_B_clearance/trajectory.csv
!results/A_to_B_clearance/trajectory.png
!results/B_to_A_clearance/
!results/B_to_A_clearance/metrics.yaml
!results/B_to_A_clearance/trajectory.csv
!results/B_to_A_clearance/trajectory.png
# Keep the current clearance-first Smac + RPP regression evidence reviewable.
!results/smac_rpp_055_final_A_to_B/
!results/smac_rpp_055_final_A_to_B/metrics.yaml
!results/smac_rpp_055_final_A_to_B/trajectory.csv
!results/smac_rpp_055_final_A_to_B/trajectory.png
!results/smac_rpp_055_final_B_to_A/
!results/smac_rpp_055_final_B_to_A/metrics.yaml
!results/smac_rpp_055_final_B_to_A/trajectory.csv
!results/smac_rpp_055_final_B_to_A/trajectory.png
# Keep the six-run benchmark and its parameter snapshots reviewable.
!results/benchmark_2026-08-20/
!results/benchmark_2026-08-20/**
# Keep the final goal-line planner triple regression reviewable.
!results/optimization_2026-08-20/
results/optimization_2026-08-20/*
!results/optimization_2026-08-20/goal_line_quad_045_A_to_B_run_01/
!results/optimization_2026-08-20/goal_line_quad_045_A_to_B_run_01/**
!results/optimization_2026-08-20/goal_line_quad_045_A_to_B_run_02/
