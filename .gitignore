# ROS 2 and colcon outputs
build/
install/
log/
.ros/

# Gazebo, RViz and local desktop state
.gazebo/
.config/
.rviz2/

# Python caches
__pycache__/
*.py[cod]

# Generated navigation trials
results/*
!results/.gitkeep
# The archive is grouped by experiment type. Keep these directories visible so
# new formal runs can be reviewed and committed without editing this file again.
!results/README.md
!results/01_原生规划基准/
!results/01_原生规划基准/**
!results/02_目标线规划优化/
!results/02_目标线规划优化/**
!results/03_V4快速目标线/
!results/03_V4快速目标线/**
!results/04_自适应目标线多目标/
!results/04_自适应目标线多目标/**
!results/05_跨场景验证/
!results/05_跨场景验证/**

# Local environment overrides
.env

# Oracle Gate evidence is retained locally in full. The raw Gazebo transport
# and compressed sqlite bags are large binary streams; their reproducible
# summaries, metadata, CSVs, plots and logs remain versioned below, while the
# raw streams stay beside the checkout for full forensic review.
experiments/oracle_mppi/**/gazebo_contacts.log.gz
experiments/oracle_mppi/**/rosbag/*.db3.zstd
experiments/oracle_mppi/**/*.log
experiments/oracle_mppi/**/runtime_*.txt
experiments/oracle_mppi/**/*_probe.txt
