<?xml version="1.0"?>
<sdf version="1.6">
  <world name="indoor_obstacle_course">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.82 0.86 0.90 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- A 12 m x 8 m enclosed room. The wall tops are deliberately above
         the camera so the RGB-D sensor only sees the indoor scene. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.2 0.2 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.2 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1</ambient>
            <diffuse>0.62 0.65 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.2 0.2 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.2 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1</ambient>
            <diffuse>0.62 0.65 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6.0 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.2 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.2 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1</ambient>
            <diffuse>0.62 0.65 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6.0 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.2 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.2 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1</ambient>
            <diffuse>0.62 0.65 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The central barrier blocks the straight A -> B line. -->
    <model name="barrier_orange">
      <static>true</static>
      <pose>-0.8 0.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 0.45 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.45 0.9</size></box></geometry>
          <material>
            <ambient>0.85 0.28 0.05 1</ambient>
            <diffuse>0.95 0.34 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Offset blocks make the detour visible and prevent a trivial one-turn
         path from looking like an obstacle-free run. -->
    <model name="block_blue">
      <static>true</static>
      <pose>1.85 1.15 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.35 1.0 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.35 1.0 0.9</size></box></geometry>
          <material>
            <ambient>0.04 0.32 0.78 1</ambient>
            <diffuse>0.05 0.42 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_green">
      <static>true</static>
      <pose>-2.0 -1.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.25 1.15 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.25 1.15 0.8</size></box></geometry>
          <material>
            <ambient>0.08 0.58 0.25 1</ambient>
            <diffuse>0.10 0.72 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_purple">
      <static>true</static>
      <pose>3.7 -1.4 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.9 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.9 0.7</size></box></geometry>
          <material>
            <ambient>0.52 0.12 0.58 1</ambient>
            <diffuse>0.68 0.18 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Flat visual-only markers for the documented start and goal. -->
    <model name="start_marker">
      <static>true</static>
      <pose>-4.5 0.0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.36</radius><length>0.012</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.75 0.25 1</ambient>
            <diffuse>0.05 0.90 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="goal_marker">
      <static>true</static>
      <pose>4.5 0.0 0.007 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.36</radius><length>0.014</length></cylinder></geometry>
          <material>
            <ambient>0.90 0.08 0.08 1</ambient>
            <diffuse>1.0 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 12.5 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
