<?xml version="1.0"?>
<sdf version="1.6">
  <world name="indoor_obstacle_course_cross_scene_01">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.82 0.86 0.90 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Same room envelope as the frozen baseline; only the interior layout changes. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
        <remapping>model_states:=model_states</remapping>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <model name="wall_north">
      <static>true</static>
      <pose>0 7.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.2 0.2 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20.2 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.62 0.65 0.70 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -7.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.2 0.2 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20.2 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.62 0.65 0.70 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>10.0 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 14.2 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 14.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.62 0.65 0.70 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-10.0 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 14.2 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 14.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.62 0.65 0.70 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Scene 01: the first bar is vertical, and the remaining bars are shifted
         so the old large-scene corridor is no longer the natural route. -->
    <model name="barrier_west">
      <static>true</static>
      <pose>-4.3 1.0 0.45 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.55 4.4 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 4.4 0.9</size></box></geometry>
          <material><ambient>0.85 0.28 0.05 1</ambient><diffuse>0.95 0.34 0.06 1</diffuse></material></visual>
      </link>
    </model>
    <model name="barrier_center">
      <static>true</static>
      <pose>0.6 1.8 0.45 0 0 -0.10</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.6 0.55 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.6 0.55 0.9</size></box></geometry>
          <material><ambient>0.08 0.32 0.78 1</ambient><diffuse>0.06 0.42 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <model name="barrier_east">
      <static>true</static>
      <pose>5.2 1.1 0.45 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.55 4.0 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 4.0 0.9</size></box></geometry>
          <material><ambient>0.78 0.12 0.14 1</ambient><diffuse>0.92 0.16 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <model name="crate_west_north">
      <static>true</static>
      <pose>-7.0 3.2 0.45 0 0 0.10</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.5 1.0 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 1.0 0.9</size></box></geometry>
          <material><ambient>0.08 0.58 0.25 1</ambient><diffuse>0.10 0.72 0.30 1</diffuse></material></visual></link>
    </model>
    <model name="crate_west_south">
      <static>true</static>
      <pose>-7.0 -3.2 0.4 0 0 -0.12</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.5 1.0 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 1.0 0.8</size></box></geometry>
          <material><ambient>0.72 0.42 0.06 1</ambient><diffuse>0.86 0.52 0.08 1</diffuse></material></visual></link>
    </model>
    <model name="crate_center_north">
      <static>true</static>
      <pose>-1.2 4.3 0.45 0 0 0.20</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.5 1.1 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 1.1 0.9</size></box></geometry>
          <material><ambient>0.78 0.40 0.06 1</ambient><diffuse>0.94 0.52 0.08 1</diffuse></material></visual></link>
    </model>
    <model name="crate_center_south">
      <static>true</static>
      <pose>0.8 -4.1 0.45 0 0 -0.18</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.6 1.0 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 1.0 0.9</size></box></geometry>
          <material><ambient>0.52 0.12 0.58 1</ambient><diffuse>0.68 0.18 0.75 1</diffuse></material></visual></link>
    </model>
    <model name="crate_east_north">
      <static>true</static>
      <pose>7.2 3.2 0.45 0 0 0.12</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.4 1.0 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 1.0 0.9</size></box></geometry>
          <material><ambient>0.04 0.48 0.72 1</ambient><diffuse>0.05 0.62 0.90 1</diffuse></material></visual></link>
    </model>
    <model name="crate_east_south">
      <static>true</static>
      <pose>7.2 -3.4 0.45 0 0 -0.16</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.4 1.0 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 1.0 0.9</size></box></geometry>
          <material><ambient>0.58 0.16 0.20 1</ambient><diffuse>0.76 0.22 0.25 1</diffuse></material></visual></link>
    </model>
    <model name="pillar_center_north">
      <static>true</static>
      <pose>2.8 3.4 0.6 0 0 0.12</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.9 2.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.9 2.0 1.2</size></box></geometry>
          <material><ambient>0.36 0.36 0.40 1</ambient><diffuse>0.48 0.50 0.56 1</diffuse></material></visual></link>
    </model>
    <model name="pillar_center_south">
      <static>true</static>
      <pose>-2.8 -3.4 0.6 0 0 -0.12</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.9 2.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.9 2.0 1.2</size></box></geometry>
          <material><ambient>0.36 0.36 0.40 1</ambient><diffuse>0.48 0.50 0.56 1</diffuse></material></visual></link>
    </model>

    <!-- Keep the documented comparison endpoints unchanged. -->
    <model name="start_marker">
      <static>true</static>
      <pose>-8.5 0.0 0.006 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><cylinder><radius>0.36</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.05 0.75 0.25 1</ambient><diffuse>0.05 0.90 0.30 1</diffuse></material></visual></link>
    </model>
    <model name="goal_marker">
      <static>true</static>
      <pose>8.5 0.0 0.007 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><cylinder><radius>0.36</radius><length>0.014</length></cylinder></geometry>
        <material><ambient>0.90 0.08 0.08 1</ambient><diffuse>1.0 0.12 0.12 1</diffuse></material></visual></link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 22.0 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
